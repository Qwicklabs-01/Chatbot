# Netlify Environment Variables Example
# DO NOT commit your actual .env file with real keys to GitHub.
# Rename this file to .env for local testing, or paste these keys into your Netlify Dashboard.

# Groq API Key (For Llama 3 70B AI Chat / Text Analysis)
# Get a free key at: https://console.groq.com/
GROQ_API_KEY=your_groq_api_key_here

# Hugging Face Token (For Free Image Generation & Vision)
# Get a free token at: https://huggingface.co/settings/tokens
HUGGINGFACE_TOKEN=your_hugging_face_token_here
