/* 
   Mobile Chatbot Design System 
   Theme: Futuristic Dark Glassmorphism (Neon Violet, Teal & Magenta)
*/

@import url('https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700&display=swap');

:root {
  /* Color Palette */
  --bg-space: #07050f;
  --bg-gradient: linear-gradient(135deg, #0b071e 0%, #05030a 100%);
  --panel-glass: rgba(20, 15, 38, 0.6);
  --panel-glass-hover: rgba(30, 24, 56, 0.75);
  --border-glass: rgba(255, 255, 255, 0.08);
  --border-active: rgba(168, 85, 247, 0.5); /* Purple accent */
  
  --color-primary: #a855f7; /* Purple */
  --color-primary-glow: rgba(168, 85, 247, 0.35);
  --color-secondary: #06b6d4; /* Teal */
  --color-secondary-glow: rgba(6, 182, 212, 0.35);
  --color-accent: #ec4899; /* Pink/Magenta */
  --color-accent-glow: rgba(236, 72, 153, 0.35);
  
  --text-main: #f3f4f6;
  --text-muted: #9ca3af;
  --text-disabled: #6b7280;
  
  --shadow-neon-purple: 0 0 15px rgba(168, 85, 247, 0.4);
  --shadow-neon-teal: 0 0 15px rgba(6, 182, 212, 0.4);
  --shadow-device: 0 25px 50px -12px rgba(0, 0, 0, 0.8), 0 0 30px rgba(168, 85, 247, 0.15);

  --font-family: 'Outfit', sans-serif;
  --transition-smooth: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
}

* {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
  -webkit-tap-highlight-color: transparent;
}

body {
  background-color: var(--bg-space);
  background-image: var(--bg-gradient);
  font-family: var(--font-family);
  color: var(--text-main);
  min-height: 100vh;
  display: flex;
  justify-content: center;
  align-items: center;
  overflow: hidden;
}

/* Smartphone Frame Emulator (Desktop Only) */
.device-wrapper {
  position: relative;
  width: 410px;
  height: 840px;
  background: #000;
  border: 12px solid #1a1a24;
  border-radius: 48px;
  box-shadow: var(--shadow-device);
  display: flex;
  flex-direction: column;
  overflow: hidden;
  transition: var(--transition-smooth);
}

/* Phone notch details */
.device-wrapper::before {
  content: '';
  position: absolute;
  top: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 150px;
  height: 28px;
  background: #1a1a24;
  border-bottom-left-radius: 20px;
  border-bottom-right-radius: 20px;
  z-index: 100;
  pointer-events: none;
}

/* Camera and Speaker simulation inside the notch */
.device-notch-camera {
  position: absolute;
  top: 8px;
  left: calc(50% + 40px);
  width: 8px;
  height: 8px;
  background: #10101c;
  border-radius: 50%;
  box-shadow: inset 0 0 2px rgba(255,255,255,0.4);
  z-index: 101;
  pointer-events: none;
}
.device-notch-speaker {
  position: absolute;
  top: 5px;
  left: 50%;
  transform: translateX(-50%);
  width: 40px;
  height: 4px;
  background: #333;
  border-radius: 2px;
  z-index: 101;
  pointer-events: none;
}

/* The actual phone screen area */
.app-container {
  flex: 1;
  display: flex;
  flex-direction: column;
  background: radial-gradient(circle at top left, #120b2e, #07040d);
  position: relative;
  overflow: hidden;
  height: 100%;
}

/* Simulated Mobile Status Bar */
.status-bar {
  height: 44px;
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
  padding: 0 24px 8px 24px;
  font-size: 12px;
  font-weight: 500;
  color: var(--text-main);
  background: rgba(0, 0, 0, 0.2);
  z-index: 90;
  user-select: none;
}

.status-bar-time {
  letter-spacing: -0.2px;
}

.status-bar-icons {
  display: flex;
  gap: 6px;
  align-items: center;
}

/* Header Area */
.app-header {
  padding: 16px 20px;
  background: rgba(15, 10, 32, 0.4);
  backdrop-filter: blur(10px);
  border-bottom: 1px solid var(--border-glass);
  display: flex;
  align-items: center;
  justify-content: space-between;
  z-index: 80;
}

.header-identity {
  display: flex;
  align-items: center;
  gap: 12px;
}

.bot-avatar-wrapper {
  position: relative;
}

.bot-avatar {
  width: 42px;
  height: 42px;
  border-radius: 50%;
  background: linear-gradient(135deg, var(--color-primary), var(--color-secondary));
  display: flex;
  justify-content: center;
  align-items: center;
  font-weight: 700;
  color: white;
  font-size: 18px;
  text-shadow: 0 2px 4px rgba(0,0,0,0.3);
  box-shadow: 0 0 10px var(--color-primary-glow);
}

.bot-status-dot {
  position: absolute;
  bottom: 0;
  right: 0;
  width: 10px;
  height: 10px;
  background-color: #10b981; /* green */
  border: 2px solid #000;
  border-radius: 50%;
  animation: pulse-green 2s infinite;
}

@keyframes pulse-green {
  0% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(16, 185, 129, 0.7); }
  70% { transform: scale(1); box-shadow: 0 0 0 6px rgba(16, 185, 129, 0); }
  100% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(16, 185, 129, 0); }
}

.header-text h1 {
  font-size: 16px;
  font-weight: 600;
  letter-spacing: 0.2px;
}

.header-text p {
  font-size: 11px;
  color: var(--text-muted);
  display: flex;
  align-items: center;
  gap: 4px;
}

.header-actions {
  display: flex;
  gap: 8px;
}

.header-btn {
  background: var(--panel-glass);
  border: 1px solid var(--border-glass);
  color: var(--text-main);
  width: 34px;
  height: 34px;
  border-radius: 50%;
  display: flex;
  justify-content: center;
  align-items: center;
  cursor: pointer;
  font-size: 14px;
  transition: var(--transition-smooth);
}

.header-btn:hover {
  background: var(--panel-glass-hover);
  border-color: var(--border-active);
  transform: translateY(-1px);
}

/* Chat Messages Scroll Panel */
.chat-messages {
  flex: 1;
  overflow-y: auto;
  padding: 20px;
  display: flex;
  flex-direction: column;
  gap: 16px;
  scroll-behavior: smooth;
}

/* Custom Scrollbar for Chat Messages */
.chat-messages::-webkit-scrollbar {
  width: 4px;
}
.chat-messages::-webkit-scrollbar-track {
  background: transparent;
}
.chat-messages::-webkit-scrollbar-thumb {
  background: rgba(168, 85, 247, 0.2);
  border-radius: 10px;
}
.chat-messages::-webkit-scrollbar-thumb:hover {
  background: rgba(168, 85, 247, 0.4);
}

/* Message Bubbles */
.message {
  display: flex;
  flex-direction: column;
  max-width: 85%;
  animation: message-in 0.3s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  opacity: 0;
  transform: translateY(12px);
}

@keyframes message-in {
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.message.user {
  align-self: flex-end;
}

.message.bot {
  align-self: flex-start;
}

.message-content {
  padding: 12px 16px;
  border-radius: 20px;
  font-size: 14px;
  line-height: 1.5;
  word-break: break-word;
  position: relative;
}

.message.user .message-content {
  background: linear-gradient(135deg, var(--color-primary), #8b5cf6);
  color: #fff;
  border-bottom-right-radius: 4px;
  box-shadow: 0 4px 15px var(--color-primary-glow);
}

.message.bot .message-content {
  background: var(--panel-glass);
  border: 1px solid var(--border-glass);
  color: var(--text-main);
  border-bottom-left-radius: 4px;
  box-shadow: 0 4px 15px rgba(0, 0, 0, 0.2);
}

/* Embedded interactive elements inside message */
.message-meta {
  font-size: 9px;
  color: var(--text-muted);
  margin-top: 4px;
  align-self: flex-end;
  padding: 0 4px;
  display: flex;
  align-items: center;
  gap: 4px;
}

.message.bot .message-meta {
  align-self: flex-start;
}

/* Audio Read Button in Bot Message */
.read-aloud-btn {
  background: none;
  border: none;
  color: var(--text-muted);
  cursor: pointer;
  font-size: 11px;
  display: inline-flex;
  align-items: center;
  padding: 2px;
  transition: color 0.2s;
  margin-left: 8px;
}

.read-aloud-btn:hover {
  color: var(--color-secondary);
}

/* Quick Suggestion Chips */
.suggestion-wrapper {
  overflow-x: auto;
  white-space: nowrap;
  padding: 8px 20px;
  display: flex;
  gap: 8px;
  z-index: 50;
}

.suggestion-wrapper::-webkit-scrollbar {
  display: none; /* Hide scrollbars for cleaner look */
}

.chip {
  display: inline-flex;
  align-items: center;
  padding: 8px 14px;
  background: rgba(20, 15, 38, 0.4);
  border: 1px solid var(--border-glass);
  border-radius: 18px;
  font-size: 12px;
  color: var(--text-muted);
  cursor: pointer;
  transition: var(--transition-smooth);
}

.chip:hover {
  background: rgba(168, 85, 247, 0.15);
  color: var(--color-primary);
  border-color: var(--border-active);
  transform: scale(1.02);
}

/* Typing Indicator Animation */
.typing-indicator {
  display: flex;
  gap: 4px;
  padding: 6px 8px;
  align-items: center;
}

.typing-dot {
  width: 6px;
  height: 6px;
  background: var(--text-muted);
  border-radius: 50%;
  animation: typing-bounce 1.4s infinite ease-in-out both;
}

.typing-dot:nth-child(1) { animation-delay: -0.32s; }
.typing-dot:nth-child(2) { animation-delay: -0.16s; }

@keyframes typing-bounce {
  0%, 80%, 100% { transform: scale(0); }
  40% { transform: scale(1.0); }
}

/* Bottom Chat Control Bar */
.chat-footer {
  padding: 12px 20px 24px 20px;
  background: rgba(10, 5, 24, 0.6);
  backdrop-filter: blur(12px);
  border-top: 1px solid var(--border-glass);
  display: flex;
  flex-direction: column;
  gap: 12px;
  z-index: 70;
}

.input-row {
  display: flex;
  gap: 10px;
  align-items: center;
}

.voice-btn {
  background: var(--panel-glass);
  border: 1px solid var(--border-glass);
  color: var(--text-muted);
  width: 44px;
  height: 44px;
  border-radius: 50%;
  display: flex;
  justify-content: center;
  align-items: center;
  cursor: pointer;
  font-size: 18px;
  transition: var(--transition-smooth);
  flex-shrink: 0;
}

.voice-btn.recording {
  background: var(--color-accent);
  color: white;
  border-color: var(--color-accent);
  animation: recording-pulse 1.5s infinite;
  box-shadow: 0 0 15px var(--color-accent-glow);
}

@keyframes recording-pulse {
  0% { transform: scale(1); box-shadow: 0 0 0 0 rgba(236, 72, 153, 0.7); }
  70% { transform: scale(1.06); box-shadow: 0 0 0 10px rgba(236, 72, 153, 0); }
  100% { transform: scale(1); box-shadow: 0 0 0 0 rgba(236, 72, 153, 0); }
}

.voice-btn:hover:not(.recording) {
  background: var(--panel-glass-hover);
  border-color: var(--color-secondary);
  color: var(--color-secondary);
}

.input-container {
  flex: 1;
  position: relative;
  display: flex;
  align-items: center;
}

.chat-input {
  width: 100%;
  height: 44px;
  background: rgba(15, 10, 32, 0.8);
  border: 1px solid var(--border-glass);
  border-radius: 24px;
  padding: 0 50px 0 18px;
  font-family: var(--font-family);
  font-size: 14px;
  color: var(--text-main);
  outline: none;
  transition: var(--transition-smooth);
}

.chat-input:focus {
  border-color: var(--color-primary);
  box-shadow: 0 0 10px rgba(168, 85, 247, 0.2);
}

.send-btn {
  position: absolute;
  right: 6px;
  background: linear-gradient(135deg, var(--color-primary), #8b5cf6);
  border: none;
  color: white;
  width: 32px;
  height: 32px;
  border-radius: 50%;
  display: flex;
  justify-content: center;
  align-items: center;
  cursor: pointer;
  transition: var(--transition-smooth);
}

.send-btn:hover {
  transform: scale(1.05);
  box-shadow: 0 0 8px var(--color-primary-glow);
}

.send-btn svg {
  width: 14px;
  height: 14px;
  fill: currentColor;
  transform: rotate(-45deg) translate(1px, -1px);
}

/* Skills Panel (Dockable Slide-up Drawer & Inline Panel) */
.skills-drawer, .skills-panel {
  position: relative;
  width: 100%;
  height: 295px;
  background: rgba(12, 8, 28, 0.4);
  backdrop-filter: blur(10px);
  border-top: 1.5px solid var(--border-glass);
  border-bottom: 1.5px solid var(--border-glass);
  padding: 12px 16px;
  display: flex;
  flex-direction: column;
  flex-shrink: 0;
  z-index: 50;
}

.drawer-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12px;
  flex-shrink: 0;
}

.drawer-header h3 {
  font-size: 16px;
  font-weight: 600;
  color: var(--color-secondary);
  display: flex;
  align-items: center;
  gap: 8px;
}

.drawer-close-btn {
  background: transparent;
  border: none;
  color: var(--text-muted);
  font-size: 24px;
  cursor: pointer;
}

/* Tab Navigation inside drawer */
.drawer-tabs {
  display: flex;
  gap: 4px;
  border-bottom: 1px solid var(--border-glass);
  padding-bottom: 8px;
  margin-bottom: 16px;
  flex-shrink: 0;
  overflow-x: auto;
  scrollbar-width: none;
}

.drawer-tabs::-webkit-scrollbar {
  display: none;
}

.tab-btn {
  position: relative;
  z-index: 1; /* keep button text above indicator background */
  background: transparent;
  border: none;
  color: var(--text-muted);
  padding: 8px 12px;
  font-size: 13px;
  font-weight: 500;
  cursor: pointer;
  border-radius: 8px;
  transition: var(--transition-smooth);
  white-space: nowrap;
}

.tab-btn.active {
  background: transparent !important;
  color: var(--color-primary);
  box-shadow: none !important;
}

.drawer-tab-indicator {
  position: absolute;
  top: 0;
  left: 0;
  height: 36px;
  background: rgba(168, 85, 247, 0.15);
  border: 1px solid var(--border-active);
  box-shadow: inset 0 0 5px rgba(168, 85, 247, 0.1);
  border-radius: 8px;
  transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1), width 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  z-index: 0;
  pointer-events: none;
}

.drawer-content-container {
  flex: 1;
  overflow-y: auto;
  padding-right: 4px;
}

.drawer-content-container::-webkit-scrollbar {
  width: 3px;
}
.drawer-content-container::-webkit-scrollbar-thumb {
  background: rgba(255, 255, 255, 0.1);
  border-radius: 2px;
}

.tab-content {
  display: none;
  flex-direction: column;
  gap: 16px;
}

.tab-content.active {
  display: flex;
}

.skill-card {
  background: rgba(255, 255, 255, 0.02);
  border: 1px solid var(--border-glass);
  border-radius: 16px;
  padding: 14px;
  display: flex;
  flex-direction: column;
  gap: 8px;
}

.skill-card-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.skill-title {
  display: flex;
  align-items: center;
  gap: 10px;
  font-size: 14px;
  font-weight: 600;
}

.skill-icon {
  font-size: 18px;
  color: var(--color-secondary);
}

.skill-status-badge {
  font-size: 10px;
  padding: 2px 8px;
  border-radius: 10px;
  background: rgba(255,255,255,0.06);
  color: var(--text-muted);
}

.skill-status-badge.active {
  background: rgba(6, 182, 212, 0.15);
  color: var(--color-secondary);
  border: 1px solid rgba(6, 182, 212, 0.3);
}

.skill-desc {
  font-size: 12px;
  color: var(--text-muted);
  line-height: 1.4;
}

/* File Parser specific upload design */
.file-upload-zone {
  border: 2px dashed rgba(6, 182, 212, 0.3);
  border-radius: 12px;
  padding: 14px;
  text-align: center;
  cursor: pointer;
  transition: var(--transition-smooth);
  font-size: 12px;
}

.file-upload-zone:hover {
  background: rgba(6, 182, 212, 0.05);
  border-color: var(--color-secondary);
}

.file-input {
  display: none;
}

.file-details {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: rgba(0, 0, 0, 0.2);
  padding: 6px 10px;
  border-radius: 8px;
  font-size: 11px;
}

.file-remove-btn {
  background: transparent;
  border: none;
  color: var(--color-accent);
  cursor: pointer;
}

/* PDF Tools specific grids */
.pdf-row-flex {
  display: flex;
  gap: 8px;
}

.pdf-mini-uploader {
  flex: 1;
  padding: 10px 4px;
  font-size: 10px;
  border-radius: 8px;
  border-width: 1px;
}

.pdf-actions-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 6px;
  margin-top: 8px;
}

/* Universal Calculator & Writing Hub Results Card */
.universal-result-card {
  background: rgba(0, 0, 0, 0.35);
  border: 1px solid rgba(6, 182, 212, 0.2);
  border-radius: 12px;
  padding: 12px;
  box-shadow: inset 0 1px 3px rgba(255, 255, 255, 0.05);
}

.universal-result-text {
  font-family: monospace;
  font-size: 12px;
  line-height: 1.5;
  color: #00ffcc;
  white-space: pre-wrap;
  word-break: break-word;
  margin-top: 6px;
  max-height: 120px;
  overflow-y: auto;
}

/* AI Detector progress bar meter styling */
.ai-detector-bar-container {
  width: 100%;
  height: 8px;
  background: rgba(255, 255, 255, 0.05);
  border-radius: 4px;
  margin-top: 6px;
  overflow: hidden;
  border: 1px solid var(--border-glass);
}

.ai-detector-bar {
  height: 100%;
  background: linear-gradient(90deg, #10b981 0%, #f59e0b 50%, #ef4444 100%);
  width: 0%;
  transition: width 0.6s ease;
}

/* Text diff highlighter classes (Grammar suggestions) */
.diff-del {
  background: rgba(239, 68, 68, 0.2);
  text-decoration: line-through;
  color: #f87171;
  padding: 0 2px;
  border-radius: 2px;
}

.diff-ins {
  background: rgba(16, 185, 129, 0.25);
  color: #34d399;
  font-weight: 600;
  padding: 0 2px;
  border-radius: 2px;
}

/* Scientific Calculator Screen Display */
.calc-display-screen {
  background: rgba(0, 0, 0, 0.4);
  border: 1px solid var(--border-glass);
  border-radius: 12px;
  color: #00ffcc;
  font-family: monospace;
  font-size: 18px;
  text-align: right;
  padding: 10px 14px;
  outline: none;
  width: 100%;
  box-shadow: inset 0 2px 4px rgba(0,0,0,0.5);
  letter-spacing: 0.5px;
}

/* Scientific Calculator Keypad Grid */
.calculator-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 6px;
  margin-top: 6px;
}

.calc-btn {
  background: rgba(255, 255, 255, 0.03);
  border: 1px solid var(--border-glass);
  border-radius: 8px;
  color: var(--text-main);
  height: 36px;
  font-size: 13px;
  font-weight: 500;
  cursor: pointer;
  display: flex;
  justify-content: center;
  align-items: center;
  transition: var(--transition-smooth);
}

.calc-btn:hover {
  background: rgba(255, 255, 255, 0.08);
}

.calc-btn.op-btn {
  background: rgba(6, 182, 212, 0.1);
  color: var(--color-secondary);
  border-color: rgba(6, 182, 212, 0.2);
}

.calc-btn.op-btn:hover {
  background: var(--color-secondary);
  color: black;
}

.calc-btn.math-func {
  background: rgba(168, 85, 247, 0.1);
  color: var(--color-primary);
  border-color: rgba(168, 85, 247, 0.2);
  font-size: 11px;
}

.calc-btn.math-func:hover {
  background: var(--color-primary);
  color: white;
}

.calc-btn.clear-btn {
  background: rgba(239, 68, 68, 0.1);
  color: #ef4444;
  border-color: rgba(239, 68, 68, 0.2);
}

.calc-btn.clear-btn:hover {
  background: #ef4444;
  color: white;
}

.calc-btn.equal-btn {
  background: linear-gradient(135deg, var(--color-accent), #db2777);
  color: white;
  grid-column: span 1;
  font-weight: 600;
  box-shadow: 0 0 10px rgba(236, 72, 153, 0.3);
}

.calc-btn.equal-btn:hover {
  box-shadow: 0 0 15px rgba(236, 72, 153, 0.5);
  transform: scale(1.02);
}

/* Math Solvers boxes */
.solver-box {
  border-top: 1px solid var(--border-glass);
  padding-top: 8px;
  margin-top: 4px;
}

.solver-box:first-of-type {
  border-top: none;
  padding-top: 0;
  margin-top: 0;
}

.solver-title {
  font-size: 11px;
  font-weight: 600;
  color: var(--color-secondary);
  margin-bottom: 6px;
}

.solver-row {
  display: flex;
  gap: 6px;
}

.solver-input {
  flex: 1;
  background: rgba(0, 0, 0, 0.3);
  border: 1px solid var(--border-glass);
  border-radius: 8px;
  padding: 6px 10px;
  color: #fff;
  font-size: 12px;
  outline: none;
  width: 100%;
}

.solver-select {
  background: rgba(15, 10, 32, 0.9);
  border: 1px solid var(--border-glass);
  border-radius: 8px;
  color: var(--text-main);
  padding: 6px 10px;
  font-size: 12px;
  outline: none;
  cursor: pointer;
}

/* Code Evaluator UI inside card */
.code-eval-row {
  display: flex;
  gap: 8px;
}

.code-eval-input {
  flex: 1;
  background: rgba(0, 0, 0, 0.3);
  border: 1px solid var(--border-glass);
  border-radius: 8px;
  padding: 6px 10px;
  color: #fff;
  font-family: monospace;
  font-size: 12px;
  outline: none;
}

.code-eval-btn {
  background: rgba(168, 85, 247, 0.2);
  border: 1px solid var(--border-active);
  color: var(--color-primary);
  border-radius: 8px;
  padding: 0 12px;
  font-size: 12px;
  cursor: pointer;
  transition: var(--transition-smooth);
  height: 32px;
  display: inline-flex;
  justify-content: center;
  align-items: center;
  white-space: nowrap;
}

.code-eval-btn:hover {
  background: var(--color-primary);
  color: white;
}

/* Prompt Builder & Writing forms Styles */
.prompt-builder-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 8px;
}

.prompt-label {
  font-size: 10px;
  color: var(--text-muted);
  display: block;
  margin-bottom: 2px;
}

.prompt-textarea {
  height: 60px;
  font-family: var(--font-family);
  resize: none;
}

.prompt-output-area {
  height: 90px;
  background: rgba(0, 0, 0, 0.5);
  border-color: var(--color-primary-glow);
  font-family: monospace;
  font-size: 11px;
}

.prompt-result-wrapper {
  animation: message-in 0.3s cubic-bezier(0.16, 1, 0.3, 1) forwards;
}

/* Floating Skills Hub Button */
.skills-hub-btn {
  display: none !important;
}

.skills-hub-btn:hover {
  background: var(--panel-glass-hover);
  border-color: var(--color-secondary);
  color: var(--color-secondary);
  box-shadow: 0 0 10px var(--color-secondary-glow);
}

/* Global status alert banner */
.status-alert {
  position: absolute;
  top: 50px;
  left: 20px;
  right: 20px;
  background: rgba(6, 182, 212, 0.9);
  color: black;
  font-weight: 600;
  font-size: 12px;
  padding: 8px 16px;
  border-radius: 12px;
  z-index: 200;
  text-align: center;
  transform: translateY(-80px);
  opacity: 0;
  transition: transform 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275), opacity 0.3s;
  box-shadow: 0 10px 20px rgba(0, 0, 0, 0.3);
}

.status-alert.show {
  transform: translateY(0);
  opacity: 1;
}

/* System messages in chat */
.message.system {
  align-self: center;
  max-width: 90%;
  animation: message-in 0.3s ease;
}

.message.system .message-content {
  background: rgba(255, 255, 255, 0.05);
  border: 1px solid rgba(255, 255, 255, 0.05);
  color: var(--text-muted);
  border-radius: 12px;
  padding: 6px 12px;
  font-size: 11px;
  text-align: center;
}

/* Premium Prompt Generator Card Styles */
.prompt-generator-card {
  position: relative;
  border-radius: 16px;
  padding: 1.5px;
  background: linear-gradient(90deg, #4ade80 0%, #06b6d4 33%, #3b82f6 66%, #ec4899 100%);
  box-shadow: 0 8px 32px rgba(6, 182, 212, 0.15);
  margin-top: 10px;
}

.prompt-generator-inner {
  background: rgba(12, 8, 28, 0.96);
  border-radius: 15px;
  padding: 16px;
  display: flex;
  flex-direction: column;
  gap: 12px;
}

.prompt-generator-textarea {
  width: 100%;
  height: 80px;
  background: transparent !important;
  border: none !important;
  outline: none !important;
  resize: none;
  font-family: var(--font-family);
  font-size: 14px;
  color: var(--text-main);
  padding: 0;
}

.prompt-generator-bottom {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 4px;
}

.prompt-pill-select {
  background: rgba(255, 255, 255, 0.05);
  border: 1px solid var(--border-glass);
  border-radius: 20px;
  padding: 5px 12px;
  font-size: 12px;
  color: var(--text-main);
  cursor: pointer;
  outline: none;
  transition: var(--transition-smooth);
}

.prompt-pill-select:hover {
  background: rgba(255, 255, 255, 0.08);
  border-color: rgba(255, 255, 255, 0.2);
}

.prompt-pill-btn {
  background: #15803d;
  background: linear-gradient(135deg, #16a34a, #15803d);
  border: none;
  color: white;
  border-radius: 20px;
  padding: 6px 14px;
  font-size: 12px;
  font-weight: 600;
  cursor: pointer;
  display: flex;
  align-items: center;
  gap: 4px;
  transition: var(--transition-smooth);
}

.prompt-pill-btn:hover {
  transform: translateY(-1px);
  box-shadow: 0 0 10px rgba(74, 222, 128, 0.4);
}

/* Image-to-Prompt Analyzer Styling */
.analyzer-img-preview {
  width: 70px;
  height: 70px;
  object-fit: cover;
  border-radius: 8px;
  border: 1px solid var(--border-glass);
}

.analyzer-swatches-container {
  display: flex;
  gap: 8px;
  align-items: center;
  margin-top: 6px;
}

.analyzer-color-swatch {
  width: 24px;
  height: 24px;
  border-radius: 50%;
  border: 1px solid rgba(255, 255, 255, 0.2);
  box-shadow: 0 0 8px rgba(0, 0, 0, 0.5);
  display: flex;
  justify-content: center;
  align-items: center;
  font-size: 8px;
  color: white;
  text-shadow: 0 1px 2px black;
  font-weight: bold;
}

/* Custom Premium Range Inputs Slider Styling */
.premium-slider {
  -webkit-appearance: none;
  width: 100%;
  height: 6px;
  background: rgba(255, 255, 255, 0.05);
  border: 1px solid var(--border-glass);
  border-radius: 3px;
  outline: none;
  margin: 8px 0;
  transition: var(--transition-smooth);
}

.premium-slider::-webkit-slider-runnable-track {
  width: 100%;
  height: 4px;
  cursor: pointer;
  background: transparent;
}

.premium-slider::-webkit-slider-thumb {
  -webkit-appearance: none;
  appearance: none;
  width: 16px;
  height: 16px;
  border-radius: 50%;
  background: linear-gradient(135deg, var(--color-secondary), var(--color-primary));
  box-shadow: 0 0 8px var(--color-secondary-glow);
  cursor: pointer;
  margin-top: -6px; /* Offset for alignment in Chrome */
  transition: var(--transition-smooth);
  border: 1px solid rgba(255, 255, 255, 0.2);
}

.premium-slider::-webkit-slider-thumb:hover {
  transform: scale(1.15);
  box-shadow: 0 0 12px var(--color-primary-glow);
}

/* Left Sliding Chat Sessions Sidebar */
.history-sidebar {
  position: absolute;
  top: 0;
  left: 0;
  width: 290px;
  height: 100%;
  background: rgba(10, 6, 26, 0.98);
  backdrop-filter: blur(30px);
  border-right: 1.5px solid var(--border-active);
  z-index: 300;
  transform: translateX(-100%);
  transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1);
  padding: 20px;
  display: flex;
  flex-direction: column;
  box-shadow: 15px 0 30px rgba(0, 0, 0, 0.6);
}

.history-sidebar.open {
  transform: translateX(0);
}

.history-sidebar-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20px;
}

.history-sidebar-header h3 {
  font-size: 16px;
  font-weight: 700;
  color: var(--color-secondary);
}

.history-sessions-list {
  flex: 1;
  overflow-y: auto;
  display: flex;
  flex-direction: column;
  gap: 8px;
  padding-right: 4px;
}

.history-sessions-list::-webkit-scrollbar {
  width: 3px;
}
.history-sessions-list::-webkit-scrollbar-thumb {
  background: rgba(255, 255, 255, 0.1);
  border-radius: 2px;
}

.session-item-wrapper {
  display: flex;
  align-items: center;
  width: 100%;
  gap: 4px;
}

.session-item-btn {
  background: rgba(255, 255, 255, 0.02);
  border: 1px solid var(--border-glass);
  border-radius: 12px;
  padding: 10px 14px;
  display: flex;
  justify-content: space-between;
  align-items: center;
  cursor: pointer;
  transition: var(--transition-smooth);
  flex: 1;
  text-align: left;
  overflow: hidden;
}

.session-item-btn:hover {
  background: rgba(168, 85, 247, 0.1);
  border-color: var(--border-active);
}

.session-item-btn.active {
  background: rgba(6, 182, 212, 0.12);
  border-color: var(--color-secondary);
}

.session-info {
  display: flex;
  flex-direction: column;
  gap: 2px;
  overflow: hidden;
  flex: 1;
}

.session-title {
  font-size: 13px;
  font-weight: 500;
  color: var(--text-main);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.session-meta {
  font-size: 10px;
  color: var(--text-muted);
}

.session-delete-btn {
  background: transparent;
  border: none;
  color: var(--text-disabled);
  cursor: pointer;
  font-size: 16px;
  padding: 4px;
  display: flex;
  justify-content: center;
  align-items: center;
  transition: color 0.2s;
}

.session-delete-btn:hover {
  color: #f87171;
}

/* Left Vertical Skills Sidebar */
.vertical-skills-sidebar {
  display: none !important;
}

.vertical-skills-sidebar::-webkit-scrollbar {
  display: none; /* Hide scrollbar for Chrome/Safari */
}

.sidebar-new-btn {
  background: rgba(74, 222, 128, 0.15) !important;
  color: #4ade80 !important;
  width: 46px;
  height: 46px;
  border-radius: 12px;
  border: 1px solid rgba(74, 222, 128, 0.35);
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  gap: 2px;
  cursor: pointer;
  font-size: 9px;
  font-weight: 700;
  margin-bottom: 4px;
  transition: var(--transition-smooth);
}

.sidebar-new-btn:hover {
  background: rgba(74, 222, 128, 0.25) !important;
  transform: scale(1.05);
  box-shadow: 0 0 10px rgba(74, 222, 128, 0.2);
}

.sidebar-btn {
  background: transparent;
  border: none;
  color: var(--text-muted);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 4px;
  cursor: pointer;
  width: 100%;
  padding: 6px 2px;
  transition: var(--transition-smooth);
  font-size: 8.5px;
  font-weight: 500;
  text-align: center;
  border-left: 2px solid transparent;
}

.sidebar-btn svg {
  width: 20px;
  height: 20px;
  stroke: currentColor;
  stroke-width: 2;
  transition: var(--transition-smooth);
}

.sidebar-btn:hover {
  color: var(--color-secondary);
}

.sidebar-btn:hover svg {
  transform: scale(1.1);
}

.sidebar-btn.active {
  color: var(--color-primary);
  border-left-color: var(--color-primary);
  background: rgba(168, 85, 247, 0.05);
}

.main-workspace {
  display: flex;
  flex-direction: column;
  flex: 1;
  height: 100%;
  overflow: hidden;
  position: relative;
  padding-bottom: 60px !important;
}

/* Adjustments for Split-screen contents */
.skills-panel {
  border-top: none !important;
  border-bottom: none !important;
}

/* --- Mobile Bottom Navigation --- */
.mobile-bottom-nav {
  display: flex; /* Always visible in mobile app view */
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  height: 60px;
  background: rgba(15, 10, 32, 0.85);
  backdrop-filter: blur(25px);
  -webkit-backdrop-filter: blur(25px);
  border-top: 1px solid var(--border-glass);
  z-index: 99;
  justify-content: space-around;
  align-items: center;
  padding: 0 10px;
  box-shadow: 0 -5px 25px rgba(0, 0, 0, 0.5);
}

.mobile-nav-btn {
  background: none;
  border: none;
  color: var(--text-muted);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 4px;
  font-size: 10px;
  font-weight: 500;
  cursor: pointer;
  flex: 1;
  height: 100%;
  transition: var(--transition-smooth);
}

.mobile-nav-btn svg {
  width: 20px;
  height: 20px;
  stroke: currentColor;
  fill: none;
  stroke-width: 2;
  transition: var(--transition-smooth);
}

.mobile-nav-btn:hover {
  color: var(--text-main);
}

.mobile-nav-btn.active {
  color: var(--color-secondary);
  text-shadow: 0 0 10px var(--color-secondary-glow);
}

.mobile-nav-btn.active svg {
  stroke: var(--color-secondary);
  filter: drop-shadow(0 0 5px var(--color-secondary-glow));
  transform: translateY(-2px);
}

/* --- Markdown & Text Formatting Styles --- */
.message-content h3, .message-content h4,
.universal-result-text h3, .universal-result-text h4 {
  font-size: 14px;
  margin-top: 10px;
  margin-bottom: 4px;
  color: var(--color-secondary);
  font-weight: 600;
}

.message-content strong, .universal-result-text strong {
  color: #fff;
  font-weight: 600;
}

.message-content em, .universal-result-text em {
  font-style: italic;
}

.message-content ul, .message-content ol,
.universal-result-text ul, .universal-result-text ol {
  margin-left: 18px;
  margin-top: 6px;
  margin-bottom: 6px;
}

.message-content li, .universal-result-text li {
  margin-bottom: 4px;
  list-style-type: disc;
}

.inline-code {
  background: rgba(255, 255, 255, 0.12);
  padding: 2px 6px;
  border-radius: 4px;
  font-family: monospace;
  font-size: 12px;
  color: var(--color-accent);
}

/* --- Mobile Responsive Rules (< 768px) --- */
@media (max-width: 767px) {
  body {
    background-image: none;
    background-color: var(--bg-space);
  }

  /* Force layout to fill screen */
  .device-wrapper {
    width: 100vw !important;
    height: 100vh !important;
    max-width: 100vw !important;
    max-height: 100vh !important;
    border: none !important;
    border-radius: 0 !important;
    box-shadow: none !important;
  }

  .device-wrapper::before,
  .device-notch-camera,
  .device-notch-speaker,
  .status-bar {
    display: none !important;
  }

  /* Hide vertical skills sidebar, bottom bar will replace it */
  .vertical-skills-sidebar {
    display: none !important;
  }

  /* Show bottom navigation bar */
  .mobile-bottom-nav {
    display: flex !important;
  }

  /* Adjust height and spacing of main workspace to fit bottom nav */
  .main-workspace {
    padding-bottom: 60px !important;
  }

  /* Ensure the mode dropdowns are visible on mobile */
  .solver-select {
    display: block !important;
  }

  /* Adjust header buttons padding for spacing */
  .app-header {
    padding: 12px 16px;
  }

  /* Add extra padding at bottom of scrollable areas */
  .chat-messages {
    padding-bottom: 40px;
  }
}

/* --- Modal Overlay & Contents --- */
.modal-overlay {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(5, 3, 10, 0.7);
  backdrop-filter: blur(15px);
  -webkit-backdrop-filter: blur(15px);
  z-index: 200;
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 20px;
}

.modal-content {
  width: 100%;
  max-width: 370px;
  max-height: 90%;
  overflow-y: auto;
  border-radius: 24px;
  border: 1px solid var(--border-glass);
  box-shadow: var(--shadow-device);
  padding: 24px;
  display: flex;
  flex-direction: column;
  gap: 20px;
}

.modal-content::-webkit-scrollbar {
  width: 4px;
}

.modal-content::-webkit-scrollbar-thumb {
  background: var(--border-glass);
  border-radius: 2px;
}

.modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  border-bottom: 1px solid var(--border-glass);
  padding-bottom: 12px;
}

.modal-header h2 {
  font-size: 18px;
  font-weight: 600;
  color: var(--color-secondary);
}

.modal-close-btn {
  background: none;
  border: none;
  color: var(--text-muted);
  font-size: 24px;
  cursor: pointer;
  line-height: 1;
}

.modal-close-btn:hover {
  color: var(--color-accent);
}

.modal-section {
  display: flex;
  flex-direction: column;
  gap: 10px;
  border-bottom: 1px solid rgba(255, 255, 255, 0.04);
  padding-bottom: 16px;
}

.modal-section:last-of-type {
  border-bottom: none;
  padding-bottom: 0;
}

.modal-section h3 {
  font-size: 14px;
  font-weight: 600;
  color: var(--color-primary);
  display: flex;
  align-items: center;
  gap: 6px;
  margin-bottom: 4px;
}

.modal-section p {
  font-size: 12px;
  line-height: 1.5;
  color: var(--text-muted);
}

/* Forms & inputs inside modal */
.form-input {
  width: 100%;
  background: rgba(255, 255, 255, 0.04);
  border: 1px solid var(--border-glass);
  border-radius: 8px;
  color: var(--text-main);
  padding: 8px 12px;
  font-size: 12px;
  font-family: inherit;
  outline: none;
  transition: var(--transition-smooth);
}

.form-input:focus {
  border-color: var(--color-secondary);
  background: rgba(255, 255, 255, 0.08);
}

/* Star ratings selection */
.rating-stars {
  display: flex;
  gap: 6px;
  font-size: 20px;
  color: var(--text-muted);
  cursor: pointer;
  user-select: none;
}

.rating-stars .star {
  transition: var(--transition-smooth);
}

.rating-stars .star:hover {
  transform: scale(1.2);
}

.rating-stars .star.selected {
  color: #fbbf24; /* yellow */
  text-shadow: 0 0 8px rgba(251, 191, 36, 0.5);
}

/* Reviews List items styling */
.reviews-list {
  display: flex;
  flex-direction: column;
  gap: 8px;
  max-height: 140px;
  overflow-y: auto;
  margin-bottom: 10px;
  padding-right: 4px;
}

.review-item {
  background: rgba(255, 255, 255, 0.02);
  border: 1px solid rgba(255, 255, 255, 0.04);
  border-radius: 8px;
  padding: 8px;
  display: flex;
  flex-direction: column;
  gap: 4px;
}

.review-item-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 11px;
  font-weight: 500;
}

.review-author {
  color: var(--text-main);
}

.review-stars {
  color: #fbbf24;
}

.review-text {
  font-size: 11px;
  color: var(--text-muted);
  line-height: 1.4;
}

